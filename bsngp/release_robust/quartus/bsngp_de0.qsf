# Binary-SNGP real-time accelerator for Terasic DE0-Nano (Cyclone IV E EP4CE22F17C6)
# Pin numbers from the DE0-Nano user manual; check them against your board's manual revision.
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE22F17C6
set_global_assignment -name TOP_LEVEL_ENTITY bsngp_de0_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_1993
set_global_assignment -name VHDL_FILE ../rtl/bsngp_params_pkg.vhd
set_global_assignment -name VHDL_FILE ../rtl/bsngp_demo_rom_pkg.vhd
set_global_assignment -name VHDL_FILE ../rtl/bsngp_core.vhd
set_global_assignment -name VHDL_FILE ../rtl/uart_rx.vhd
set_global_assignment -name VHDL_FILE ../rtl/uart_tx.vhd
set_global_assignment -name VHDL_FILE ../rtl/bsngp_de0_top.vhd
set_global_assignment -name SDC_FILE bsngp_de0.sdc
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"

# 50 MHz clock
set_location_assignment PIN_R8 -to CLOCK_50
# Push buttons (active low): KEY0 = reset
set_location_assignment PIN_J15 -to KEY[0]
set_location_assignment PIN_E1 -to KEY[1]
# DIP switches: SW0 source (1 = UART), SW1 slow ROM replay
set_location_assignment PIN_M1 -to SW[0]
set_location_assignment PIN_T8 -to SW[1]
set_location_assignment PIN_B9 -to SW[2]
set_location_assignment PIN_M15 -to SW[3]
# LEDs
set_location_assignment PIN_A15 -to LED[0]
set_location_assignment PIN_A13 -to LED[1]
set_location_assignment PIN_B13 -to LED[2]
set_location_assignment PIN_A11 -to LED[3]
set_location_assignment PIN_D1 -to LED[4]
set_location_assignment PIN_F3 -to LED[5]
set_location_assignment PIN_B1 -to LED[6]
set_location_assignment PIN_L3 -to LED[7]
# UART on expansion header JP1 (3.3 V LVTTL levels; use a 3.3 V USB-UART adapter)
#   GPIO_0[0] (JP1 pin 2) = UART_RXD  <- adapter TX
#   GPIO_0[1] (JP1 pin 4) = UART_TXD  -> adapter RX ; JP1 pin 12 = GND
set_location_assignment PIN_D3 -to UART_RXD
set_location_assignment PIN_C3 -to UART_TXD
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to UART_RXD
